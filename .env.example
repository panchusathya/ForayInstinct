# Optional in local development; required elsewhere.
# Better Auth passwordless SMS.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects these automatically on Vercel. `pnpm
# dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Required for browser execution outside the Vercel one-click flow.
# Bright Data Browser API zone credentials as `username:password`.
BRIGHT_DATA_BROWSER_AUTH=
# Required in Vercel production. Create a paid Vercel AI Gateway key and add
# it as `AI_GATEWAY_API_KEY`; this prevents free-tier model fallbacks.
AI_GATEWAY_API_KEY=
# Optional Vercel Connect configuration.
GOOGLE_CONNECTOR_UID=
# The Vercel Connect attachment supplies this automatically in production.
# Set the number when you want to display the assigned Linq line in the app.
LINQ_CONNECTOR=
LINQ_PHONE_NUMBER=
# GoForay recruiter bridge. The API hostname is JuiceBox, while this app is
# served at https://apply.goforay.io. Both services hold the same random value;
# it is used only to sign five-minute service tokens and never reaches a browser.
JUICEBOX_API_URL=https://api.goforay.io
OPENINSTINCT_SHARED_SECRET=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
