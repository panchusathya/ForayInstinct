# Optional in local development; required elsewhere.
# Better Auth passwordless SMS.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# The Neon Marketplace resource injects these automatically on Vercel. `pnpm
# dev` starts the Docker Compose database on an ephemeral local port (see
# compose.yaml) and overrides both; set them only for an externally managed
# database, as `pnpm dev:app` expects.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/open_instinct
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Optional rotation keyring: comma-separated `kid=base64` pairs, each a 32-byte
# key. The first seals new writes and every listed key still decrypts;
# SECRET_ENCRYPTION_KEY keeps decrypting envelopes written before rotation and
# is re-sealed under the first key as secrets are read.
SECRET_ENCRYPTION_KEYS=
# Which backend hosts worker browsers: "kernel" (default) or "gateway"
# (the Brightdata browser gateway service under services/browser-gateway).
# Flipping this is the rollout/rollback switch.
BROWSER_PROVIDER=kernel
# Required when BROWSER_PROVIDER=gateway: the deployed gateway's base URL and
# its shared bearer secret. Brightdata credentials live only on the gateway.
BROWSER_GATEWAY_URL=
BROWSER_GATEWAY_SECRET=
# Required when BROWSER_PROVIDER=kernel (browser execution outside the Vercel
# one-click flow). The Kernel Marketplace resource injects this automatically
# on Vercel.
KERNEL_API_KEY=
# Optional Kernel dashboard proxy ID. Worker browsers keep stealth and attach
# this proxy so traffic leaves through your residential/custom exit instead of
# Kernel's default shared ISP pool.
KERNEL_PROXY_ID=
# Required in Vercel production. Create a paid Vercel AI Gateway key and add
# it as `AI_GATEWAY_API_KEY`; this prevents free-tier model fallbacks.
AI_GATEWAY_API_KEY=
# Optional Vercel Connect configuration.
GOOGLE_CONNECTOR_UID=
# The Vercel Connect attachment supplies this automatically in production.
# Set the number when you want to display the assigned Linq line in the app.
LINQ_CONNECTOR=
LINQ_PHONE_NUMBER=
# Direct Linq credentials, for a sandbox account or running without Vercel
# Connect. Set both together; LINQ_CONNECTOR is the alternative.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Extra hosts iMessage attachments may be downloaded from (sandbox only).
LINQ_ATTACHMENT_HOSTS=
# Optional Exa key for the coordinator web_search tool.
EXA_API_KEY=
# GoForay recruiter bridge. The API hostname is JuiceBox, while this app is
# served at https://apply.goforay.io. Both services hold the same random value;
# it is used only to sign five-minute service tokens and never reaches a browser.
JUICEBOX_API_URL=https://api.goforay.io
OPENINSTINCT_SHARED_SECRET=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
